# Environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Data (regenerate with `make data`)
data/raw/*
data/processed/*
data/synthetic/*
!data/**/.gitkeep
# The small demo slice is tracked on purpose: the hosted app only ever has
# what the repository contains.
!data/samples/
!data/samples/*.parquet

# Trained artifacts (regenerate with `make train`). The autoencoder and its
# scaler are small enough to track, so the demo app works on a fresh clone
# before anything is trained; the 10 MB Isolation Forest is not.
models/*
!models/.gitkeep
!models/autoencoder.pt
!models/autoencoder.config.json
!models/preprocessor.joblib
!models/calibration_scores.npz
!models/model_card.json

# OS
.DS_Store
